{
    "name": "fikamessaging/email",
    "description": "Laravel mail transport for Fika transactional email.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/mail": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "symfony/mailer": "^7.2|^8.0",
        "symfony/mime": "^7.2|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Fika\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fika\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fika\\Laravel\\FikaServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
